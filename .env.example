# Copie para ~/.config/zora/.env (ou exporte no shell).
# NUNCA versione este arquivo com valores reais.

# --- OpenCode Server ---
# Deixe vazio para a Zora gerenciar um servidor por projeto automaticamente.
# ZORA_OPENCODE_BASE_URL=http://127.0.0.1:4096
# ZORA_OPENCODE_DIRECTORY=/caminho/do/projeto
# ZORA_OPENCODE_MODEL=deepseek/deepseek-flash
# ZORA_OPENCODE_AGENT=build
# ZORA_OPENCODE_AUTO_START=true
# Senha do servidor (HTTP Basic). Use a mesma de OPENCODE_SERVER_PASSWORD.
# ZORA_OPENCODE_PASSWORD=

# --- Voz ---
# ZORA_TTS_PROVIDER=edge   # edge | say | none
# ZORA_TTS_VOICE=pt-BR-FranciscaNeural
# ZORA_STT_MODEL=small
# ZORA_STT_LANGUAGE=pt
# ZORA_STT_CONFIRM_TRANSCRIPT=false
# Legendas parciais ao vivo:
# ZORA_STT_PARTIAL_TRANSCRIPTION=true
# ZORA_STT_PARTIAL_INTERVAL_SECONDS=1.5
# ZORA_STT_PARTIAL_WINDOW_SECONDS=10
# ZORA_AUDIO_INPUT_DEVICE=
# Escuta continua: microfone aberto; fala -> executa -> responde -> volta a ouvir.
# ZORA_AUDIO_CONTINUOUS=true
# Pausa que encerra uma fala (em ms; 5000 = 5s):
# ZORA_AUDIO_SILENCE_MS=5000
# 0 = sem limite para uma fala:
# ZORA_AUDIO_MAX_SECONDS=0
# Silêncio (em segundos) que desliga o microfone automaticamente (0 = nunca):
# ZORA_AUDIO_AUTO_MUTE_SECONDS=30

# --- Second Brain ---
# ZORA_SECOND_BRAIN_PATH=~/SecondBrain
# ZORA_SECOND_BRAIN_INDEX=
# ZORA_SB_PREFERENCES_FILE=~/SecondBrain/preferences.md
# Criar nota nao pergunta por padrao; editar/excluir continuam pedindo.
# ZORA_SB_CONFIRM_CREATE=false
# ZORA_SB_REQUIRE_CONFIRMATION=true
# Reindexar a cada inicio (pode ser lento em bases grandes):
# ZORA_SB_REINDEX_ON_START=false

# --- OpenCode ---
# Auto-aprovar ferramentas do agente (PERIGOSO; padrao false).
# ZORA_OPENCODE_AUTO_APPROVE=false

# --- Iniciativa (proatividade) ---
# ZORA_PROACTIVE_ENABLED=true
# ZORA_PROACTIVE_STARTUP_GREETING=true
# ZORA_PROACTIVE_IDLE_CHECKIN=true
# ZORA_PROACTIVE_IDLE_MINUTES=45
# ZORA_PROACTIVE_MIN_INTERVAL_MINUTES=60
# ZORA_PROACTIVE_DAILY_MAX=4
# ZORA_PROACTIVE_QUIET_HOURS=23:00-08:00
# ZORA_PROACTIVE_CHECK_INTERVAL_SECONDS=30
# ZORA_PROACTIVE_REMINDERS=true

# --- WhatsApp Cloud API (Meta) ---
# Crie um app em developers.facebook.com, adicione o produto WhatsApp e
# use o Phone Number ID + token de acesso. Segredos apenas aqui no .env.
# ZORA_WHATSAPP_ENABLED=true
# ZORA_WHATSAPP_PHONE_NUMBER_ID=
# ZORA_WHATSAPP_ACCESS_TOKEN=
# Token que VOCE define e informa tambem no painel da Meta (webhook).
# ZORA_WHATSAPP_VERIFY_TOKEN=
# Numero que recebe as mensagens da Zora (formato internacional, so digitos).
# ZORA_WHATSAPP_RECIPIENT=5584999999999
# ZORA_WHATSAPP_API_VERSION=v21.0
# ZORA_WHATSAPP_WEBHOOK_HOST=127.0.0.1
# ZORA_WHATSAPP_WEBHOOK_PORT=8765

# --- Telegram Bot API ---
# Crie um bot com @BotFather (/newbot) e cole o token aqui.
# ZORA_TELEGRAM_ENABLED=true
# ZORA_TELEGRAM_BOT_TOKEN=
# Vazio => usa o primeiro chat que falar com o bot.
# ZORA_TELEGRAM_ALLOWED_CHAT_ID=
# ZORA_TELEGRAM_POLL_TIMEOUT=25
# Responder também com áudio (mp3):
# ZORA_TELEGRAM_VOICE_REPLIES=false

# --- Navegador (Playwright) ---
# ZORA_BROWSER_ENABLED=true
# ZORA_BROWSER_PROFILE_DIR=~/.local/share/zora/browser
# ZORA_BROWSER_HEADLESS=true

# --- Agenda (Supabase) ---
# Leitura das tarefas do dia para avisos proativos.
# ZORA_AGENDA_ENABLED=true
# ZORA_AGENDA_ENV_FILE=~/agenda-git/agenda/.env
# ZORA_AGENDA_POLL_MINUTES=30
# ZORA_AGENDA_MAX_ITEMS=5
# ZORA_AGENDA_TASKS_POLL_SECONDS=30
# ZORA_AGENDA_NOTIFY_PENDING=false

# --- Dados locais ---
# ZORA_DATA_DIR=~/.local/share/zora
# ZORA_CONFIG=~/.config/zora/config.toml
