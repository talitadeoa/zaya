# Copie para ~/.config/zaya/.env (ou exporte no shell).
# NUNCA versione este arquivo com valores reais.

# --- Agente (modelo) ---
# Provedor: deepseek | openai | openrouter | ollama | anthropic | custom
# ZAYA_AGENT_PROVIDER=deepseek
# ZAYA_AGENT_MODEL=deepseek-chat
# Endpoint custom (vazio = endpoint padrao do provedor):
# ZAYA_AGENT_BASE_URL=
# Chave da API (ou use DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY):
# ZAYA_AGENT_API_KEY=
# Diretorio de trabalho do agente (vazio = diretorio atual):
# ZAYA_AGENT_DIRECTORY=/caminho/do/projeto
# Limites do turno:
# ZAYA_AGENT_MAX_TOKENS=4096
# ZAYA_AGENT_TEMPERATURE=0.3
# ZAYA_AGENT_MAX_STEPS=32
# ZAYA_AGENT_REQUEST_TIMEOUT=900
# ZAYA_AGENT_STALL_TIMEOUT=90
# Retomar a sessao salva ao abrir:
# ZAYA_AGENT_RESUME_SESSION=true
# Ferramentas (leitura, escrita, shell):
# ZAYA_AGENT_TOOLS=true
# Permitir acesso fora do diretorio do projeto:
# ZAYA_AGENT_ALLOW_OUTSIDE_PROJECT=true
# Economia de tokens:
# Modelo pequeno para pedidos curtos (vazio = sempre o principal):
# ZAYA_AGENT_FAST_MODEL=deepseek-chat
# Enviar so as ferramentas que o turno pode usar:
# ZAYA_AGENT_TOOL_FILTER=true
# Cachear persona + preferencias (Anthropic):
# ZAYA_AGENT_CACHE_PROMPT=true
# Depois disso o historico antigo vira um resumo:
# ZAYA_AGENT_MAX_HISTORY_MESSAGES=20
# ZAYA_AGENT_MAX_HISTORY_CHARS=24000
# ZAYA_AGENT_SUMMARY_CHARS=1200
# Medir tokens por turno (aparece no /status):
# ZAYA_AGENT_USAGE=true
# Teto de resultado de ferramenta guardado no histórico (0 = sem teto):
# ZAYA_AGENT_TOOL_RESULT_CHARS=4000
# Resumo do histórico: local (extrativo) | llm (semântico, com fallback local):
# ZAYA_AGENT_HISTORY_SUMMARY=local
# Modelo do resumo (vazio = modelo principal):
# ZAYA_AGENT_HISTORY_SUMMARY_MODEL=

# --- Voz ---
# ZAYA_TTS_PROVIDER=edge   # edge | say | none
# ZAYA_TTS_VOICE=pt-BR-FranciscaNeural
# ZAYA_STT_MODEL=small
# ZAYA_STT_LANGUAGE=pt
# ZAYA_STT_CONFIRM_TRANSCRIPT=false
# Legendas parciais ao vivo:
# ZAYA_STT_PARTIAL_TRANSCRIPTION=true
# ZAYA_STT_PARTIAL_INTERVAL_SECONDS=1.5
# ZAYA_STT_PARTIAL_WINDOW_SECONDS=10
# ZAYA_AUDIO_INPUT_DEVICE=
# Escuta continua: microfone aberto; fala -> executa -> responde -> volta a ouvir.
# ZAYA_AUDIO_CONTINUOUS=true
# Pausa que encerra uma fala (em ms; 5000 = 5s):
# ZAYA_AUDIO_SILENCE_MS=5000
# 0 = sem limite para uma fala:
# ZAYA_AUDIO_MAX_SECONDS=0
# Silêncio (em segundos) que desliga o microfone automaticamente (0 = nunca):
# ZAYA_AUDIO_AUTO_MUTE_SECONDS=30
# Mostrar raciocínio e diffs no terminal:
# ZAYA_UI_SHOW_REASONING=true
# ZAYA_UI_SHOW_DIFFS=true
# Painéis de metas e lua começam recolhidos:
# ZAYA_UI_DASHBOARD_COLLAPSED=true

# --- Second Brain ---
# ZAYA_SECOND_BRAIN_PATH=~/SecondBrain
# ZAYA_SECOND_BRAIN_INDEX=
# ZAYA_SB_PREFERENCES_FILE=~/SecondBrain/preferences.md
# ZAYA_SB_CONTEXT_RESULTS=2
# ZAYA_SB_CONTEXT_CHARS=480
# ZAYA_SB_CONTEXT_MAX_CHARS=1200
# Criar nota nao pergunta por padrao; editar/excluir continuam pedindo.
# ZAYA_SB_CONFIRM_CREATE=false
# ZAYA_SB_REQUIRE_CONFIRMATION=true
# Reindexar a cada inicio (pode ser lento em bases grandes):
# ZAYA_SB_REINDEX_ON_START=false

# --- Agente: permissoes ---
# Auto-aprovar ferramentas do agente (PERIGOSO; padrao false).
# ZAYA_AGENT_AUTO_APPROVE=false

# --- Iniciativa (proatividade) ---
# --- Memoria diaria ---
# Consolida o dia numa nota do Second Brain (23:00, ao sair e catch-up).
# ZAYA_MEMORY_ENABLED=true
# ZAYA_MEMORY_AT=23:00
# ZAYA_MEMORY_ON_EXIT=true
# ZAYA_MEMORY_USE_LLM=true
# ZAYA_MEMORY_FOLDER=Memoria

# --- Briefing diario (Telegram, sem LLM) ---
# Bom dia as 08:00 com tarefas do dia e rotina matinal; resumo ao meio-dia.
# ZAYA_BRIEFING_ENABLED=true
# ZAYA_BRIEFING_MORNING_AT=08:00
# ZAYA_BRIEFING_NOON_AT=12:00
# ZAYA_BRIEFING_NOON_UNTIL=18:00
# ZAYA_BRIEFING_MORNING_ROUTINE=matinal
# ZAYA_BRIEFING_MAX_TASKS=15
# ZAYA_BRIEFING_MARKET_ENABLED=true
# ZAYA_BRIEFING_MARKET_AT=12:00
# ZAYA_BRIEFING_MARKET_UNTIL=18:00

# ZAYA_PROACTIVE_ENABLED=true
# ZAYA_PROACTIVE_STARTUP_GREETING=true
# ZAYA_PROACTIVE_IDLE_CHECKIN=true
# ZAYA_PROACTIVE_IDLE_MINUTES=45
# ZAYA_PROACTIVE_MIN_INTERVAL_MINUTES=60
# ZAYA_PROACTIVE_DAILY_MAX=4
# ZAYA_PROACTIVE_QUIET_HOURS=23:00-08:00
# ZAYA_PROACTIVE_CHECK_INTERVAL_SECONDS=30
# ZAYA_PROACTIVE_REMINDERS=true

# --- WhatsApp Cloud API (Meta) ---
# Crie um app em developers.facebook.com, adicione o produto WhatsApp e
# use o Phone Number ID + token de acesso. Segredos apenas aqui no .env.
# ZAYA_WHATSAPP_ENABLED=true
# ZAYA_WHATSAPP_PHONE_NUMBER_ID=
# ZAYA_WHATSAPP_ACCESS_TOKEN=
# Token que VOCE define e informa tambem no painel da Meta (webhook).
# ZAYA_WHATSAPP_VERIFY_TOKEN=
# Numero que recebe as mensagens da Zaya (formato internacional, so digitos).
# ZAYA_WHATSAPP_RECIPIENT=5584999999999
# ZAYA_WHATSAPP_API_VERSION=v21.0
# ZAYA_WHATSAPP_WEBHOOK_HOST=127.0.0.1
# ZAYA_WHATSAPP_WEBHOOK_PORT=8765

# --- Telegram Bot API ---
# Crie um bot com @BotFather (/newbot) e cole o token aqui.
# ZAYA_TELEGRAM_ENABLED=true
# ZAYA_TELEGRAM_BOT_TOKEN=
# Vazio => usa o primeiro chat que falar com o bot.
# ZAYA_TELEGRAM_ALLOWED_CHAT_ID=
# ZAYA_TELEGRAM_POLL_TIMEOUT=25
# Responder também com áudio (mp3):
# ZAYA_TELEGRAM_VOICE_REPLIES=false
# Aprovar write/edit/bash automaticamente (o Telegram não tem terminal para
# pedir permissão; exige ZAYA_TELEGRAM_ALLOWED_CHAT_ID fixado):
# ZAYA_TELEGRAM_AUTO_APPROVE=false

# --- Navegador (Playwright) ---
# ZAYA_BROWSER_ENABLED=true
# ZAYA_BROWSER_PROFILE_DIR=~/.local/share/zaya/browser
# ZAYA_BROWSER_HEADLESS=true

# --- Agenda (Supabase) ---
# Leitura das tarefas do dia para avisos proativos.
# ZAYA_AGENDA_ENABLED=true
# ZAYA_AGENDA_ENV_FILE=~/agenda-git/agenda/.env
# ZAYA_AGENDA_POLL_MINUTES=30
# ZAYA_AGENDA_MAX_ITEMS=5
# 0 = nao checa a pagina de tarefas sozinho (so no /tarefas sync):
# ZAYA_AGENDA_TASKS_POLL_SECONDS=0
# ZAYA_AGENDA_NOTIFY_PENDING=false

# --- Dados locais ---
# ZAYA_DATA_DIR=~/.local/share/zaya
# ZAYA_CONFIG=~/.config/zaya/config.toml
